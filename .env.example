# Leave DATABASE_URL unset to use the in-process PGlite database (dev/test/CI).
# In production, set it to a Postgres connection string and swap the driver in
# src/db/client.ts to node-postgres (see docs/adr/0002-database.md).
# DATABASE_URL=postgres://user:pass@host:5432/feedback

# Optional: persist the PGlite database to a directory so it survives restarts
# and is shared between `pnpm db:seed` and `pnpm dev`.
# PGLITE_DATA=.pglite
